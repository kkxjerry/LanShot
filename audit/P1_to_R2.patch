+
+def wait_for(predicate, seconds: float = 8.0) -> None:
+    deadline = time.monotonic() + seconds
+    while not predicate():
+        if time.monotonic() >= deadline:
+            raise RuntimeError('synthetic rehearsal timed out')
+        time.sleep(.02)
+
+
+def main() -> int:
