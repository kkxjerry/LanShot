+        self.heartbeat.write("starting")
+        self.worker = threading.Thread(target=self._work, name="analysis-worker", daemon=True)
+        self.monitor = threading.Thread(target=self._monitor, name="receiver-monitor", daemon=True)
+        self.worker.start()
+        self.monitor.start()
